<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Alternate app icons: there is deliberately no CFBundleIcons / CFBundleAlternateIcons here.
	  Fil ships its alternates as *.appiconset folders in Fil/Assets.xcassets, with the build
	  setting ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = YES on the Fil target. actool
	  compiles every icon set other than the primary (ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon)
	  into Assets.car and writes the CFBundleAlternateIcons dictionary into the *built* Info.plist
	  itself. Hand-writing those keys here would duplicate, and eventually contradict, what the
	  asset catalog already declares.

	  The alternative (loose per-scale PNGs at the bundle root plus hand-authored CFBundleIconFiles
	  arrays) was rejected: it means maintaining a scale ladder by hand and gives up dark and tinted
	  icon variants. See Fil/Services/AppIconManager.swift for the full reasoning and for how to add
	  an icon.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.smidgecraft.Fil.draft</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fil</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!--
	  The .filbox backup type. Exported (not imported) because Fil defines it.

	  Conforms to public.data, NOT public.zip-archive, even though the bytes are a plain zip. Files
	  handles zip types itself: a tap on a zip-conforming file extracts it in place, and no app is
	  ever asked (seen on device 2026-09-15). As plain data, a tap goes to the Owner handler, Fil.
	  The Mac side loses nothing real: the archive is still an honest zip, and "rename to .zip" or
	  Archive Utility opens it there.

	  CFBundleDocumentTypes is what makes Files → tap → Fil work. Without it, import is a menu in
	  Settings that nobody finds.
	-->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.smidgecraft.Fil.filbox</string>
			<key>UTTypeDescription</key>
			<string>Fil Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>filbox</string>
				</array>
			</dict>
		</dict>
	</array>
	<!--
	  Fil reads a tapped .filbox where it sits (a scoped read inside FilBoxImporter.run) and never
	  writes to it, so nothing is copied into Documents/Inbox and nothing is left behind. App Store
	  Connect warns on upload if a document-opening app omits this key.
	-->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Fil Backup</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.smidgecraft.Fil.filbox</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
